@import "assets/wenkai-font.wxss";

page {
  background:
    radial-gradient(circle at 10% 8%, rgba(196, 220, 140, 0.42) 0, rgba(196, 220, 140, 0) 32%),
    radial-gradient(circle at 94% 34%, rgba(154, 199, 155, 0.24) 0, rgba(154, 199, 155, 0) 38%),
    linear-gradient(165deg, #f7f7e6 0%, #eef4dc 58%, #f9f8e9 100%);
  color: #2e4a30;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background:
    radial-gradient(circle at 88% 6%, rgba(200, 224, 145, 0.2) 0, rgba(200, 224, 145, 0) 42%),
    rgba(255, 255, 246, 0.83);
  border: 1rpx solid rgba(93, 130, 72, 0.22);
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 14rpx 32rpx rgba(60, 94, 48, 0.06);
}

.title, .section-title, .section-subtitle, .stats-value,
.stats-favorite, .meal-name, .record-name, .result-name {
  font-family: "STKaiti", "KaiTi", "Kaiti SC", "Songti SC", "Noto Serif CJK SC", serif;
}

.title {
  color: #28512d;
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.35;
  margin-bottom: 12rpx;
}
.subtitle {
  color: #597455;
  font-size: 25rpx;
  line-height: 1.8;
}
.section-title {
  color: #2f5a33;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 18rpx;
}
.soft-label {
  display: inline-block;
  color: #6a9842;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.btn-primary, .btn-light {
  height: 88rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #315b37;
  background: #dce8c9;
  border: 2rpx solid #9fbd87;
  box-shadow: none;
}
.btn-primary::after, .btn-light::after { border: none; }
.btn-small {
  margin: 0;
  height: 66rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  font-size: 23rpx;
}

.pill-row, .tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pill, .tag {
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.4;
}
.pill {
  color: #4c6b41;
  background: #f7f9ed;
  border: 2rpx solid #c8d9b0;
}
.pill-active {
  color: #315b37;
  background: #dce8c9;
  border-color: #9fbd87;
}
.tag {
  color: #53733e;
  background: #edf3d8;
  border: 1rpx solid #d6e3b9;
}
.helper, .meta-text {
  color: #788b6c;
  font-size: 23rpx;
  line-height: 1.65;
}
.input, .textarea {
  box-sizing: border-box;
  color: #2f4c32;
  font-size: 27rpx;
  background: rgba(255, 255, 250, 0.88);
  border: 2rpx solid #c9d8b7;
  border-radius: 7rpx;
}
.input {
  height: 84rpx;
  padding: 0 22rpx;
  margin-bottom: 18rpx;
}
.textarea {
  width: 100%;
  min-height: 176rpx;
  padding: 18rpx 22rpx;
}
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.empty {
  color: #7c906e;
  text-align: center;
  padding: 36rpx 0;
  font-size: 25rpx;
  line-height: 1.7;
}
button { box-sizing: border-box; }
button[disabled] { opacity: 0.5; }
.title, .subtitle { overflow-wrap: break-word; }

.page { position: relative; }
.paper-texture {
  position: fixed;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  opacity: 0.48;
  pointer-events: none;
}
.page > .card, .page > .list-heading, .page > .list-intro, .page > .local-hint {
  position: relative;
  z-index: 1;
}
.card {
  background: rgba(255, 255, 248, 0.48);
  border: none;
  border-bottom: 1rpx solid rgba(76, 117, 58, 0.22);
  border-radius: 0;
  box-shadow: none;
  padding: 28rpx 8rpx;
}
.subtitle { font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif; }
.btn-primary, .btn-light { transition: transform 180ms ease, background-color 180ms ease; }
.btn-primary:active, .btn-light:active { transform: scale(0.98); }
