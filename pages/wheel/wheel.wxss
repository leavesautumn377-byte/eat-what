@import "../../assets/watercolor-theme.wxss";

.list-content, .form-content { position: relative; z-index: 1; }

.list-heading {
  margin: 8rpx 0 12rpx;
  gap: 16rpx;
  align-items: flex-start;
}
.list-heading .title { margin: 0; }
.form-hint { margin-bottom: 14rpx; }
.section-subtitle {
  color: #3b633b;
  font-size: 27rpx;
  margin: 24rpx 0 14rpx;
}
.form-actions { display: flex; gap: 14rpx; margin-top: 28rpx; }
.form-actions button { flex: 1; min-width: 0; margin: 0; }
.meal-item {
  display: block;
  padding: 34rpx 0;
  border-bottom: 1rpx solid #dce8ca;
}
.meal-item:last-child { border-bottom: none; }
.meal-info { flex: 1; min-width: 0; }
.meal-name {
  color: #315b37;
  font-size: 33rpx;
  font-weight: 700;
  overflow-wrap: break-word;
}
.meal-location {
  color: #839675;
  font-size: 23rpx;
  margin-top: 8rpx;
  overflow-wrap: break-word;
}
.meal-tags { margin-top: 14rpx; }
.meal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 22rpx;
}
.meal-actions button { flex: 1; min-width: 0; }
.page-list .back-button { margin-bottom: 14rpx; }
.page-list .meal-form .title { margin-bottom: 22rpx; }
.page-list .meal-form .section-subtitle { margin-top: 22rpx; }
.page-list .meal-name { font-size: 44rpx; font-weight: 400; }
.page-list .meal-location { font-size: 28rpx; }
.page-list .form-actions button { width: 100%; }
