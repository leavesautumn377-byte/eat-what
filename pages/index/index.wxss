@import "../../assets/watercolor-theme.wxss";

.hero-card {
  position: relative;
  padding: 36rpx 8rpx 38rpx;
  background: transparent;
  box-shadow: none;
}
.hero-card .title {
  color: #244e2a;
  font-size: 72rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
  line-height: 1.24;
  margin: 12rpx 0 22rpx;
}
.hero-card .subtitle {
  color: #496b45;
  max-width: 580rpx;
  font-size: 27rpx;
  line-height: 1.8;
}

.filter-card-shell { padding-top: 32rpx; }
.section-gap { margin-top: 32rpx; }
.filter-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.filter-grid-tags { gap: 22rpx 24rpx; }
.filter-card {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 68rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #f7f9ea;
  border: 2rpx solid #cbdcb0;
  border-radius: 999rpx;
  transition: background-color 240ms ease, border-color 240ms ease, transform 220ms ease, opacity 220ms ease;
}
.filter-grid-tags .filter-card {
  min-height: 78rpx;
  padding: 0 26rpx;
}
.filter-pressed { transform: scale(0.94); opacity: 0.72; }
.filter-card-active {
  background: #dce8c9;
  border-color: #9fbd87;
  transform: translateY(-3rpx);
}
.filter-card-active.filter-pressed { transform: translateY(-3rpx) scale(0.94); }
.filter-card-title {
  color: #4f7043;
  font-size: 25rpx;
  font-weight: 500;
  white-space: nowrap;
}
.filter-card-active .filter-card-title { color: #315b37; }
.selected-mark { margin-left: 8rpx; color: #668a51; }
.tag-head { margin-bottom: 18rpx; gap: 10rpx; }
.tag-head .section-title { margin-bottom: 0; }
.clear-tags-btn { flex-shrink: 0; }
.summary-row {
  margin-top: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #dbe6c8;
}
.action-row { display: flex; gap: 14rpx; margin-top: 20rpx; }
.action-btn, .save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 32rpx;
  letter-spacing: 3rpx;
}
.action-btn { flex: 1; min-width: 0; margin: 0; }
.empty-action { width: 230rpx; margin: 18rpx auto 0; }
.empty-filter { margin-top: 20rpx; }

.result-shell {
  background: transparent;
  border-color: rgba(76, 117, 58, 0.22);
}
.result-enter { animation: result-appear 360ms ease-out both; }
.result-leave { animation: result-disappear 180ms ease-in forwards; }
@keyframes result-appear {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes result-disappear {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(-12rpx); }
}
.result-shell .section-title { color: #689041; font-size: 29rpx; }
.result-name { color: #22542c; font-size: 54rpx; font-weight: 700; line-height: 1.35; }
.result-location { color: #688164; font-size: 25rpx; margin-top: 8rpx; }
.result-tags { margin-top: 18rpx; }
.result-actions { margin-top: 26rpx; }
.record-panel {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #cbdcab;
}
.record-hint { margin-bottom: 14rpx; }
.section-subtitle { color: #3b633b; font-size: 27rpx; margin: 22rpx 0 13rpx; }
.add-photo-btn { width: 100%; }
.photo-box { margin-top: 6rpx; }
.meal-photo { width: 100%; height: 320rpx; border-radius: 7rpx; background: #e8f1d7; }
.photo-actions { display: flex; gap: 12rpx; margin-top: 14rpx; }
.photo-btn { flex: 1; }
.save-btn { margin-top: 24rpx; }

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #dce8ca;
}
.recent-item:last-child { border-bottom: none; }
.recent-main { flex: 1; min-width: 0; padding-right: 16rpx; }
.recent-name { color: #315839; font-size: 28rpx; font-weight: 600; }
.recent-meta { color: #809474; font-size: 22rpx; margin-top: 6rpx; }
.recent-rating {
  color: #537941;
  background: #eaf2d4;
  padding: 10rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}
.local-hint { text-align: center; padding: 0 12rpx 18rpx; }

.page-pick-home .hero-card { min-height: 40vh; padding: 12rpx 4rpx 0; }
.page-pick-home .hero-card .title { font-size: 36rpx; }
.page-pick-home .filter-card-shell { padding-top: 20rpx; }
.page-pick-home .filter-grid { gap: 14rpx 26rpx; }
.page-pick-home .filter-card { min-height: 78rpx; padding: 0 12rpx; }
.page-pick-home .filter-grid-tags { gap: 20rpx 30rpx; }
.page-pick-home .filter-grid-tags .filter-card { padding: 0 12rpx; }
.page-pick-home .full-button {
  position: fixed;
  z-index: 10;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(110rpx + env(safe-area-inset-bottom) + 16rpx);
  width: auto;
  margin: 0;
}
.page-inner .result-shell, .page-inner .record-panel { margin-top: 12rpx; border-top: 0; }
.page-inner .result-name { margin-top: 38rpx; font-size: 76rpx; font-weight: 400; }
.page-inner .result-tags { margin: 22rpx 0 36rpx; }
.page-inner .record-hint { margin: 14rpx 0 26rpx; }
.page-inner .add-photo-btn, .page-inner .save-btn { width: 100%; }
.page-inner .remove-photo-btn { margin: 14rpx 0 0; }
.page-pick-home .summary-row { font-size: 30rpx; }


